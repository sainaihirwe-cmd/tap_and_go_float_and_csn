{
  "name": "tap-and-go-network-operations",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "node server/index.js",
    "dev:web": "npm --prefix frontend run dev",
    "dev:mobile": "npm --prefix mobile start",
    "dev:stack": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "seed": "node server/seed.js",
    "build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "mongoose": "^8.24.8",
    "multer": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "vite": "^6.4.5"
  }
}
